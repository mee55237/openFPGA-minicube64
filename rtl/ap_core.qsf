# Project-Wide Assignments
# ========================
set_global_assignment -name ORIGINAL_QUARTUS_VERSION 18.1.1
set_global_assignment -name PROJECT_CREATION_TIME_DATE "21:31:36  JANUARY 22, 2020"
set_global_assignment -name LAST_QUARTUS_VERSION "25.1std.0 Lite Edition"
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files
set_global_assignment -name SMART_RECOMPILE OFF
# PINNED, do set back to ALL (2026-09-28).  Quartus's parallel placement
# varies with the processor count, so a fit made with ALL is not reproducible
# count so a single build and every parallel sweep fit place IDENTICALLY and
set_global_assignment -name NUM_PARALLEL_PROCESSORS ALL

